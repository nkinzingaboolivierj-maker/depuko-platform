# DEPUKO environment template. Copy to a private .env file; never commit secrets.
NODE_ENV=development
API_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://depuko:CHANGE_ME@localhost:5432/depuko
DEPUKO_DB_PASSWORD=CHANGE_ME

# Payment and payout integrations remain disabled until provider onboarding,
# sandbox verification, signed webhooks and payout controls are completed.
PAYMENT_PROVIDER_SECRET=
PAYOUT_PROVIDER_SECRET=

# Optional AI integration. Empty means deterministic local fallback only.
AI_PROVIDER_API_KEY=

# Optional notification providers (not configured in this release candidate).
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Private file storage and malware/content scanning (must fail closed).
STORAGE_ENDPOINT=
STORAGE_BUCKET=depuko-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
FILE_SCANNER_ENDPOINT=
FILE_SCANNER_API_KEY=

# Frontend public API addresses; these are URLs, not secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
