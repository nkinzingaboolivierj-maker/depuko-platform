# DEPUKO environment template. Copy to a private .env file; never commit secrets.
NODE_ENV=development
API_PORT=4000
PORT=4000

# PostgreSQL. Use a dedicated local database and a strong password.
DATABASE_URL=postgresql://depuko:CHANGE_ME@localhost:5432/depuko
DEPUKO_DB_PASSWORD=CHANGE_ME

# OpenAI Responses API (server-side only; never expose with NEXT_PUBLIC_).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Legacy compatibility name; use OPENAI_API_KEY for new deployments.
AI_PROVIDER_API_KEY=

# Browser origins allowed to call the API. Comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional payment and payout provider secrets.
# Keep empty: payment settlement/webhook implementation is NOT approved for real money.
PAYMENT_PROVIDER_SECRET=
PAYOUT_PROVIDER_SECRET=

# Optional email and SMS providers. Not required for core local startup.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Private S3-compatible object storage. If these are absent, file upload intents return 503.
# Use an HTTPS endpoint and a private bucket; never enable public bucket access.
STORAGE_ENDPOINT=
STORAGE_BUCKET=depuko-private
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Scanner contract: POST JSON { bucket, key, mimeType, sizeBytes } with Bearer auth,
# response JSON { verdict: "clean" | "infected" }. If absent or unavailable,
# uploaded files remain quarantined and download access is denied.
FILE_SCANNER_ENDPOINT=
FILE_SCANNER_API_KEY=

# Public API base URLs for web/mobile clients (URLs only, never secrets).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
